# Runtime model config
MODEL=openai/gpt-5.5

# Required for this project
OPENAI_API_KEY=
EXA_API_KEY=
DATABASE_URL=

# Required for app-level Microsoft Entra sign-in
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Optional first-party observability
OBSERVABILITY_ENABLED=
OBSERVABILITY_CAPTURE_MESSAGES=
OBSERVABILITY_CAPTURE_RESULTS=
OBSERVABILITY_CAPTURE_FULL_CONTENT=
OBSERVABILITY_ADMIN_SECRET=
OBSERVABILITY_RETENTION_DAYS=

# Optional provider keys if you change MODEL provider
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
